# Token Bot Discord dari Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=masukkan_token_bot_disini

# Application / Client ID Bot Discord
CLIENT_ID=masukkan_client_id_disini

# (Opsional) Daftar User ID Discord kamu (pisahkan dengan koma jika lebih dari satu)
# Agar kamu selalu bisa mengatur bot dari Server Khusus Log meskipun bukan Admin di server tertentu
OWNER_IDS=

# (Opsional) ID Server Utama & ID Channel Log awal (bisa juga langsung diatur lewat command /config di Discord)
MAIN_GUILD_ID=
LOG_CHANNEL_ID=

# Zona waktu untuk perhitungan reset target harian (Default: Asia/Jakarta / WIB)
TIMEZONE=Asia/Jakarta

# Prefix untuk command teks (Default: g -> gstatus, gmonitor, glogs, ghelp)
BOT_PREFIX=g

